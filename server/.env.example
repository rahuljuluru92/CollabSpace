PORT=3001
MONGO_URI=mongodb://localhost:27017/syncspace
# Use a long random value in production (at least 32 characters), e.g. `openssl rand -hex 32`.
JWT_SECRET=dev_secret
# Comma-separated list of allowed browser origins. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173
# NODE_ENV=production
# Optional: login/register attempts allowed per IP per window (defaults: 20 per 15 minutes).
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# Optional: trace|debug|info|warn|error|fatal|silent (default info).
# LOG_LEVEL=info
